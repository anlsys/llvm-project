; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=nvptx64-nvidia-cuda -mcpu=sm_80 | FileCheck %s

; A select whose operand is an expensive, single-use, speculatable computation
; (an IEEE f64 square root or division: a refinement sequence plus a slow-path
; call on NVPTX) is turned back into a branch, so that only the threads that
; need the value pay for it. SimplifyCFG speculates such an instruction out of
; a conditional block on the assumption that CodeGenPrepare will do this.

define double @sel_sqrt(double %x) {
; CHECK-LABEL: sel_sqrt(
; CHECK:       {
; CHECK-NEXT:    .reg .pred %p<2>;
; CHECK-NEXT:    .reg .b64 %rd<3>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ld.param.b64 %rd1, [sel_sqrt_param_0];
; CHECK-NEXT:    setp.le.f64 %p1, %rd1, 0d3FF0000000000000;
; CHECK-NEXT:    mov.b64 %rd2, 0d4000000000000000;
; CHECK-NEXT:    @%p1 bra $L__BB0_2;
; CHECK-NEXT:  // %bb.1: // %select.true.sink
; CHECK-NEXT:    sqrt.rn.f64 %rd2, %rd1;
; CHECK-NEXT:  $L__BB0_2: // %select.end
; CHECK-NEXT:    st.param.b64 [func_retval0], %rd2;
; CHECK-NEXT:    ret;
  %c = fcmp ugt double %x, 1.0
  %s = call double @llvm.sqrt.f64(double %x)
  %r = select i1 %c, double %s, double 2.0
  ret double %r
}

define double @sel_div(double %x, double %y) {
; CHECK-LABEL: sel_div(
; CHECK:       {
; CHECK-NEXT:    .reg .pred %p<2>;
; CHECK-NEXT:    .reg .b64 %rd<4>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ld.param.b64 %rd2, [sel_div_param_0];
; CHECK-NEXT:    setp.le.f64 %p1, %rd2, 0d3FF0000000000000;
; CHECK-NEXT:    mov.b64 %rd3, 0d4000000000000000;
; CHECK-NEXT:    @%p1 bra $L__BB1_2;
; CHECK-NEXT:  // %bb.1: // %select.true.sink
; CHECK-NEXT:    ld.param.b64 %rd1, [sel_div_param_1];
; CHECK-NEXT:    div.rn.f64 %rd3, %rd1, %rd2;
; CHECK-NEXT:  $L__BB1_2: // %select.end
; CHECK-NEXT:    st.param.b64 [func_retval0], %rd3;
; CHECK-NEXT:    ret;
  %c = fcmp ugt double %x, 1.0
  %d = fdiv double %y, %x
  %r = select i1 %c, double %d, double 2.0
  ret double %r
}

; A cheap operand is still selected.
define double @sel_mul(double %x, double %y) {
; CHECK-LABEL: sel_mul(
; CHECK:       {
; CHECK-NEXT:    .reg .pred %p<2>;
; CHECK-NEXT:    .reg .b64 %rd<5>;
; CHECK-EMPTY:
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ld.param.b64 %rd1, [sel_mul_param_0];
; CHECK-NEXT:    setp.gtu.f64 %p1, %rd1, 0d3FF0000000000000;
; CHECK-NEXT:    ld.param.b64 %rd2, [sel_mul_param_1];
; CHECK-NEXT:    mul.rn.f64 %rd3, %rd2, %rd1;
; CHECK-NEXT:    selp.f64 %rd4, %rd3, 0d4000000000000000, %p1;
; CHECK-NEXT:    st.param.b64 [func_retval0], %rd4;
; CHECK-NEXT:    ret;
  %c = fcmp ugt double %x, 1.0
  %m = fmul double %y, %x
  %r = select i1 %c, double %m, double 2.0
  ret double %r
}

declare double @llvm.sqrt.f64(double)
